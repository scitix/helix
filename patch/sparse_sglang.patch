+        return nnz_list, validate_weights, merged_numel_list, merged_dtype_list, bucket_size
 
+    def _recv_merged_sparse_weights(self, group_name:str, merged_numel_list:list[int], merged_dtype_list:list[torch.dtype], indices_dtype:torch.dtype=torch.int32) -> dict[torch.dtype, tuple[torch.Tensor, torch.Tensor]]:
+        """Recv merged sparse weights before update_weights_from_distributed()."""
+        handles = []
+        dtype_to_sparse_tensor : dict[torch.dtype, tuple[torch.Tensor, torch.Tensor]] = {}
+
+        for merged_numel, values_dtype in zip(merged_numel_list, merged_dtype_list):
+            values_dtype = values_dtype if isinstance(values_dtype, torch.dtype) else getattr(torch, values_dtype)
+
+            merged_indices = torch.empty(merged_numel, dtype=indices_dtype, device=self.device)
+            merged_values = torch.empty(merged_numel, dtype=values_dtype, device=self.device)
+
+            handles.append(
+                torch.distributed.broadcast(
+                    merged_indices,
+                    src=0,
+                    group=self._model_update_group[group_name],
+                    async_op=True,
+                )
+            )
+            handles.append(
+                torch.distributed.broadcast(
+                    merged_values,
+                    src=0,
+                    group=self._model_update_group[group_name],
+                    async_op=True,
+                )
+            )
+            dtype_to_sparse_tensor[values_dtype] = (merged_indices, merged_values)
+        
+
+        for handle in handles:
+            handle.wait()
+        return dtype_to_sparse_tensor
