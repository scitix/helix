+        # TODO: Use enum instead of string.
+        nnz_list : list[int] | None = extra_meta_info.get("nnz_list", None)
+        validate_weights : bool = extra_meta_info.get("validate_weights", False)
+        merged_numel_list : list[int] = extra_meta_info.get("merged_numel_list", None)
+        merged_dtype_list : list[torch.dtype] = extra_meta_info.get("merged_dtype_list", None)
