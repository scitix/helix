+def update_sparse_weights_from_distributed(
+    group_name: str,
+    group: dist.ProcessGroup,
+    weight_version: int,
+    rollout_engines: Sequence[ActorHandle],
+    sparse_weight_bucket: SparseBucket,
+    *,
+    validate_weights: bool = False,
+) -> list[ObjectRef]:
+    """Sparse weight broadcast protocol.
+
+    Expects each tensor to use NaN as "unchanged" marker, converts to sparse (indices, values),
+    merges across tensors into two big buffers and broadcasts them once, along with meta.
+    """
+
+    refs = [
+        engine.update_weights_from_distributed.remote(
+            names=sparse_weight_bucket.names,
+            dtypes=sparse_weight_bucket.dtypes,
+            shapes=sparse_weight_bucket.shapes,
+            group_name=group_name,
+            weight_version=str(weight_version),
+        )
+        for engine in rollout_engines
+    ]
+
+    torch.distributed.broadcast_object_list(
+        object_list=[
+            {
+                "nnz_list": sparse_weight_bucket.nnz_list,
+                "merged_numel_list": sparse_weight_bucket.merged_numel_list,
+                "merged_dtype_list": sparse_weight_bucket.merged_dtype_list,
+                "validate_weights": bool(validate_weights),
+            }
+        ],
+        src=0,
+        group=group,
+    )
+
+    handles = []
+
+    for merged_indices, merged_values in zip(sparse_weight_bucket.merged_indices_list, sparse_weight_bucket.merged_values_list):
+        if merged_indices is None or merged_values is None:
+            continue
+        handles.append(dist.broadcast(merged_indices, 0, group=group, async_op=True))
+        handles.append(dist.broadcast(merged_values, 0, group=group, async_op=True))
+    for handle in handles:
+        handle.wait()
+
+    return refs
